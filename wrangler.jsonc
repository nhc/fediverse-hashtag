{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fediverse-hashtag-index",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",

  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // Sent on every outbound request so server admins can identify this
    // collector and find the opt-out route. Never disguise it. The URL is set
    // to the deployed coverage page after the first deploy, since that page is
    // what explains to an admin what this is and how to stop it.
    "COLLECTOR_USER_AGENT": "fediverse-hashtag-index/0.1 (+https://fediverse-hashtag-index.neil-charlton.workers.dev/coverage; public hashtag activity index, opt-out on that page; neil@bleepsystems.com)",

    // Contact address published on the coverage page, used for server and
    // author opt-out requests. Answered by a person.
    "CONTACT": "neil@bleepsystems.com",

    // Requests the collector will make per tick.
    //
    // The Workers free tier allows 50 external subrequests per invocation, and
    // a tick can also run one instance probe costing up to 5 requests on top of
    // collection. So: 43 collect + 5 probe + 2 spare = 50. Raise this on
    // Workers Paid, where the ceiling is 10,000, but keep the probe allowance
    // in the sum.
    "MAX_REQUESTS_PER_TICK": "43",

    // Bytes of JSON the collector will parse per tick before deferring the
    // rest to the next one. Cursors make deferral safe. 2 MB keeps a tick
    // inside the free tier's 10 ms of CPU; raise it well past any real tick
    // on Workers Paid. See docs/design.md.
    "MAX_PARSE_BYTES_PER_TICK": "2000000",

    // Tags polled in one batched request via any[]. The limit of 40 statuses
    // is shared across the batch, so a busy tag crowds out a quiet one.
    "MAX_TAGS_PER_BATCH": "4",

    // Pause a host when its reported rate-limit headroom drops below this.
    "RATELIMIT_FLOOR": "30",

    // Hours to keep observation rows. One more than the longest window.
    "RETENTION_HOURS": "25",

    // Discovery candidate rows written per tick.
    //
    // Recording every co-occurring tag would be several hundred writes a
    // minute, and the D1 free tier allows 100,000 rows written a day in total.
    // 60 a tick is roughly 86,000 a day, so on the free tier this competes
    // directly with observations: lower it, or track fewer tags. On Workers
    // Paid the included allowance is 50 million a month and this is noise.
    // Tags seen most often in a tick are written first.
    "MAX_CANDIDATE_WRITES_PER_TICK": "60"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fediverse-hashtag-index",
      // Created 27 August 2026, region WEUR.
      "database_id": "e39d2e52-cb54-43d3-89de-522a0f89304c",
      "migrations_dir": "./migrations"
    }
  ],

  "triggers": {
    // Every minute. This sets the floor on collection latency, and the
    // five-minute window is near-real-time rather than live because of it.
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
